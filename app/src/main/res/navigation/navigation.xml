<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation"
    app:startDestination="@id/accountFragment">

    <fragment
        android:id="@+id/accountFragment"
        android:name="com.example.Users.Account.Account"
        android:label="fragment_account"
        tools:layout="@layout/fragment_account" >
        <action
            android:id="@+id/action_accountFragment_to_AddCardFragment"
            app:destination="@id/AddCardFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.Shop.ShopFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_shop" />
    <fragment
        android:id="@+id/orderProduct"
        android:name="com.example.Users.OrderProduct.OrderProduct"
        android:label="fragment_order_product"
        tools:layout="@layout/fragment_order_product" />
<fragment
    android:id="@+id/addProduct"
    android:name="com.example.Shop.AddProduct"
    android:label="fragment_add_product"
    tools:layout="@layout/fragment_add_product"/>
    <fragment
        android:id="@+id/messgeFragment"
        android:name="com.example.Messge.MessgeFragment"
        android:label="fragment_messge"
        tools:layout="@layout/fragment_messge" />
    <fragment
        android:id="@+id/infoProduct"
        android:name="com.example.Shop.infoProduct.InfoProduct"
        android:label="fragment_order_product"
        tools:layout="@layout/fragment_info_product" />



    <fragment
        android:id="@+id/AddCardFragment"
        android:name="com.example.Card.AddCardFragment"/>
    <fragment
        android:id="@+id/AddCategories"
        android:name="com.example.Shop.AddCategories"
        android:label="addCategories"
        tools:layout="@layout/fragment_add_categories"/>
</navigation>